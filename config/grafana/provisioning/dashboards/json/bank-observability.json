              "url": "/d/bank-red-observability?var-service=${__field.labels.service_name}&from=${__from}&to=${__to}"
            }
          ]
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "\ud83d\udea8 E \u2014 Error Rate por Servi\u00e7o (Fam\u00edlias 4xx, 5xx e Total)",
      "description": "Taxa de erros discriminada por microsservi\u00e7o (account-api vs ledger-service), separando Erros 4xx (Regra de Neg\u00f3cio: Saldo Insuficiente) de Erros 5xx (Falhas Cr\u00edticas de Servidor/Banco). Clique para abrir Traces ou Logs!",
