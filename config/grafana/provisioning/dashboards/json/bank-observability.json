          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "operation",
        "label": "Opera\u00e7\u00e3o",
        "type": "custom",
        "query": "deposit,withdraw,statement",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "search",
        "label": "\ud83d\udd0e Buscar nos Logs (ex: saldo, erro, trace_id)",
        "type": "textbox",
        "query": "",
