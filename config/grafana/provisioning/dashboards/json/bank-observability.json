{
  "uid": "bank-red-observability",
  "title": "Bank Account Simulator \u2014 RED & Domain Observability",
  "tags": [
    "opentelemetry",
    "red",
    "bank",
    "observability"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 7,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "service",
